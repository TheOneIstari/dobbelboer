---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('news')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => path === '/' ? base : `${base}${path}`;
---
<BaseLayout title="Nieuws | Den Dobbelboer" description="Nieuws, gidsen en spelinspiratie van Den Dobbelboer.">
  <section class="container-dobbelboer py-14 md:py-20">
    <div class="mb-10 max-w-3xl">
      <p class="mb-2 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Blog</p>
      <h1 class="text-4xl font-black sm:text-5xl">NIEUWS & SPELTIPS</h1>
      <p class="mt-4 text-lg font-bold leading-8 text-slate-700">Hier komt het SEO-spul dat ook echt nuttig mag zijn: nieuwe spellen, picks per type speler en lokale praktische updates.</p>
    </div>
    <div class="grid gap-8 md:grid-cols-2">
      {posts.map((post) => (
        <article class="card overflow-hidden">
          {post.data.image && <img src={withBase(post.data.image)} alt={post.data.imageAlt ?? post.data.title} class="h-56 w-full border-b-4 border-black object-cover" />}
          <div class="p-6">
            <p class="mb-3 text-xs font-black uppercase tracking-[0.25em]">{post.data.pubDate.toLocaleDateString('nl-BE')}</p>
            <h2 class="text-2xl font-black leading-tight">{post.data.title}</h2>
            <p class="mt-3 text-base font-bold leading-7 text-slate-700">{post.data.description}</p>
            <a href={withBase(`/nieuws/${post.id}`)} class="btn green mt-5">LEES VERDER</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
