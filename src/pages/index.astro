---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, stats, steps } from '../data/site';
import GameCard from '../components/GameCard.astro';

const games = (await getCollection('games')).filter((g) => g.data.featured).slice(0, 3);
const posts = (await getCollection('news')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
const colorMap = {
  red: 'red-block',
  green: 'green-block',
  blue: 'blue-block',
  orange: 'orange-block',
  purple: 'purple-block',
  yellow: 'yellow-block',
} as const;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => path === '/' ? base : `${base}${path}`;
---
<BaseLayout title={site.title} description={site.description}>
  <section class="bg-gradient-to-br from-yellow-100 to-orange-100 py-16 md:py-24">
    <div class="container-dobbelboer grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="text-center lg:text-left">
        <p class="mb-4 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Elke zondag aan huis geleverd</p>
        <h1 class="text-4xl font-black leading-none sm:text-5xl md:text-6xl">DEN DOBBELBOER</h1>
        <h2 class="mt-4 text-2xl font-black leading-tight sm:text-3xl md:text-4xl">BOARDGAMES AAN HUIS, ZONDER GEDOE</h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg font-bold leading-8 text-slate-700 lg:mx-0">Zin in een leuke game night? Huur boardgames vanaf één maand en laat ze gewoon aan huis leveren in en rond Antwerpen.</p>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={withBase("/boardgames")} class="btn red">BEKIJK BOARDGAMES</a>
          <a href={withBase("/#hoe-werkt-het")} class="btn green">HOE WERKT HET?</a>
        </div>
      </div>
      <div class="card overflow-hidden bg-white p-4">
        <img src={withBase("/logo.png")} alt="Den Dobbelboer logo" class="mx-auto w-full max-w-xs object-contain" />
      </div>
    </div>
  </section>

  <section class="container-dobbelboer py-12 md:py-16">
    <div class="grid gap-6 md:grid-cols-3">
      {stats.map((stat) => (
        <article class="stat-card">
          <div class={`mx-auto mb-4 h-4 w-20 border-2 border-black ${colorMap[stat.color as keyof typeof colorMap]}`}></div>
          <h3 class="text-xl font-black">{stat.title}</h3>
          <p class="mt-2 text-base font-bold text-slate-700">{stat.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="hoe-werkt-het" class="bg-white py-14 md:py-20">
    <div class="container-dobbelboer">
      <div class="mb-10 flex flex-col items-center gap-4 text-center md:flex-row md:justify-center md:text-left">
        <img src={withBase("/question.png")} alt="Dobbelboer legt uit hoe het werkt" class="w-36 object-contain md:w-48" />
        <div>
          <p class="mb-2 inline-block border-2 border-black bg-yellow-200 px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Simpel</p>
          <h2 class="text-3xl font-black leading-tight sm:text-4xl md:text-5xl">HOE WERKT HET?</h2>
        </div>
      </div>
      <div class="grid gap-6 md:grid-cols-5">
        {steps.map((step) => (
          <article class="text-center">
            <div class={`step-dot mx-auto mb-5 ${colorMap[step.color as keyof typeof colorMap]}`}>{step.step}</div>
            <h3 class="text-lg font-black">{step.title}</h3>
            <p class="mt-2 text-sm font-bold leading-6 text-slate-700">{step.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-dobbelboer py-14 md:py-20">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-2 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Aanraders</p>
        <h2 class="text-3xl font-black sm:text-4xl">UITGELICHTE BOARDGAMES</h2>
      </div>
      <a href={withBase("/boardgames")} class="btn blue">ALLE BOARDGAMES</a>
    </div>
    <div class="grid gap-8 lg:grid-cols-3">
      {games.map((game) => (
        <GameCard
          title={game.data.title}
          summary={game.data.summary}
          players={game.data.players}
          age={game.data.age}
          playtime={game.data.playtime}
          complexity={game.data.complexity}
          category={game.data.category}
          theme={game.data.theme}
          image={game.data.image}
          imageAlt={game.data.imageAlt}
          href={withBase(`/boardgames/${game.id}`)}
          stock={game.data.stock}
          priceFrom={game.data.priceFrom}
        />
      ))}
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="container-dobbelboer grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="card p-5">
        <img src={withBase("/dries.jpeg")} alt="Dries achter Den Dobbelboer" class="h-full w-full object-cover" />
      </div>
      <div>
        <p class="mb-2 inline-block border-2 border-black bg-yellow-200 px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">About</p>
        <h2 class="text-3xl font-black sm:text-4xl">EEN EENVOUDIGE MANIER OM LEUKE BOARDGAMES OP TAFEL TE KRIJGEN</h2>
        <p class="mt-5 text-lg font-bold leading-8 text-slate-700">Den Dobbelboer is er voor mensen die graag nieuwe boardgames ontdekken zonder eerst een hele kast te moeten volstouwen. Gewoon kiezen, laten leveren en spelen.</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={withBase("/about")} class="btn orange">ABOUT</a>
          <a href={withBase("/contact")} class="btn purple">CONTACT</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-dobbelboer py-14 md:py-20">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-2 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Nieuws</p>
        <h2 class="text-3xl font-black sm:text-4xl">NIEUWS & TIPS</h2>
      </div>
      <a href={withBase("/nieuws")} class="btn red">ALLE POSTS</a>
    </div>
    <div class="grid gap-8 md:grid-cols-2">
      {posts.map((post) => (
        <article class="card overflow-hidden">
          {post.data.image && <img src={withBase(post.data.image)} alt={post.data.imageAlt ?? post.data.title} class="h-56 w-full border-b-4 border-black object-cover" />}
          <div class="p-6">
            <p class="mb-3 text-xs font-black uppercase tracking-[0.25em]">{post.data.pubDate.toLocaleDateString('nl-BE')}</p>
            <h3 class="text-2xl font-black leading-tight">{post.data.title}</h3>
            <p class="mt-3 text-base font-bold leading-7 text-slate-700">{post.data.description}</p>
            <a href={withBase(`/nieuws/${post.id}`)} class="btn green mt-5">LEES VERDER</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
