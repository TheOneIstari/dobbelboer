---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => path === '/' ? base : `${base}${path}`;
---
<BaseLayout title="Contact | Den Dobbelboer" description="Neem contact op voor reservaties, vragen of speladvies.">
  <section class="container-dobbelboer py-14 md:py-20">
    <div class="max-w-3xl">
      <p class="mb-2 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Contact</p>
      <h1 class="text-4xl font-black sm:text-5xl">RESERVEER OF STEL JE VRAAG</h1>
      <p class="mt-4 text-lg font-bold leading-8 text-slate-700">Voor nu hou ik het simpel: stuur een mailtje met welk spel je wil, voor hoe lang, en waar in of rond Antwerpen je zit.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <article class="card p-6">
          <h2 class="text-2xl font-black">MAIL</h2>
          <p class="mt-3 text-base font-bold leading-7 text-slate-700">hallo@dendobbelboer.be</p>
          <a href="mailto:hallo@dendobbelboer.be" class="btn green mt-5">MAIL ONS</a>
        </article>
        <article class="card p-6">
          <h2 class="text-2xl font-black">LEVERING</h2>
          <p class="mt-3 text-base font-bold leading-7 text-slate-700">Iedere zondag in en rond Antwerpen. Bestellen liefst voor vrijdag.</p>
          <a href={withBase("/spellen")} class="btn blue mt-5">BEKIJK SPELLEN</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
