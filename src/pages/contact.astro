---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => path === '/' ? base : `${base}${path}`;
---
<BaseLayout title="Contact | Den Dobbelboer" description="Neem contact op voor reservaties, vragen of speladvies.">
  <section class="container-dobbelboer py-14 md:py-20">
    <div class="max-w-3xl">
      <p class="mb-2 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Contact</p>
      <h1 class="text-4xl font-black sm:text-5xl">ZIN IN EEN BOARDGAME NIGHT?</h1>
      <p class="mt-4 text-lg font-bold leading-8 text-slate-700">Stuur gewoon even door welke boardgame je graag wil, hoe lang je ze wil houden en waar je woont. Dan bekijken we samen wat past.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <article class="card p-6">
          <h2 class="text-2xl font-black">MAIL</h2>
          <p class="mt-3 text-base font-bold leading-7 text-slate-700">hallo@dendobbelboer.be</p>
          <a href="mailto:hallo@dendobbelboer.be" class="btn green mt-5">STUUR EEN MAIL</a>
        </article>
        <article class="card p-6">
          <h2 class="text-2xl font-black">LEVERING</h2>
          <p class="mt-3 text-base font-bold leading-7 text-slate-700">We leveren op zondag in en rond Antwerpen. Liefst iets laten weten voor vrijdag.</p>
          <a href={withBase("/boardgames")} class="btn blue mt-5">BEKIJK BOARDGAMES</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
