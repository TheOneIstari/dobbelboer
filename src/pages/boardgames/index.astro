---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';

const games = (await getCollection('games')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => path === '/' ? base : `${base}${path}`;
---
<BaseLayout title="Board games huren | Den Dobbelboer" description="Ontdek ons aanbod board games te huur in en rond Antwerpen.">
  <section class="container-dobbelboer py-14 md:py-20">
    <div class="mb-10 max-w-3xl">
      <p class="mb-2 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">Boardgames</p>
      <h1 class="text-4xl font-black sm:text-5xl">ONZE BOARDGAMES</h1>
      <p class="mt-4 text-lg font-bold leading-8 text-slate-700">Van snelle partygames tot iets strategischer voor een lange avond. Kies gewoon iets dat past bij jouw groep en wij regelen de rest.</p>
    </div>
    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
      {games.map((game) => (
        <GameCard
          title={game.data.title}
          summary={game.data.summary}
          players={game.data.players}
          age={game.data.age}
          playtime={game.data.playtime}
          complexity={game.data.complexity}
          category={game.data.category}
          theme={game.data.theme}
          image={game.data.image}
          imageAlt={game.data.imageAlt}
          href={withBase(`/boardgames/${game.id}`)}
          stock={game.data.stock}
          priceFrom={game.data.priceFrom}
        />
      ))}
    </div>
  </section>
</BaseLayout>
