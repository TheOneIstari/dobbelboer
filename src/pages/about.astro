---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => path === '/' ? base : `${base}${path}`;
---
<BaseLayout title="About | Den Dobbelboer" description="About Den Dobbelboer and the idea behind renting boardgames at home.">
  <section class="container-dobbelboer py-14 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="card overflow-hidden">
        <img src={withBase("/dries.jpeg")} alt="Dries van Den Dobbelboer" class="h-full w-full object-cover" />
      </div>
      <div>
        <p class="mb-2 inline-block border-2 border-black bg-white px-3 py-2 text-xs font-black uppercase tracking-[0.25em]">About</p>
        <h1 class="text-4xl font-black sm:text-5xl">BOARDGAMES ONTDEKKEN ZONDER JE HUIS VOL DOZEN TE ZETTEN</h1>
        <div class="prose-dobbelboer mt-6 max-w-2xl">
          <p>Den Dobbelboer is er voor mensen die graag nieuwe boardgames spelen, maar niet voor elke leuke titel meteen plaats of budget willen voorzien.</p>
          <p>In plaats van blind te kopen, kan je hier gewoon iets kiezen, laten leveren en kijken of het echt iets voor jou en je groep is.</p>
          <p>Het idee is simpel: leuke boardgames, duidelijke afspraken en een service die licht en menselijk aanvoelt.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
