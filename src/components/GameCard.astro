---
interface Props {
  title: string;
  summary: string;
  players: string;
  age: string;
  playtime: string;
  complexity: number;
  category: string;
  theme: string;
  image: string;
  imageAlt: string;
  href: string;
  stock: number;
  priceFrom: number;
}

const { title, summary, players, age, playtime, complexity, category, theme, image, imageAlt, href, stock, priceFrom } = Astro.props;
const available = stock > 0;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => path === '/' ? base : `${base}${path}`;
---
<article class={`card overflow-hidden ${available ? '' : 'opacity-60 grayscale'}`}>
  <div class="relative">
    <img src={withBase(image)} alt={imageAlt} class="h-56 w-full border-b-4 border-black object-cover" />
    <span class="badge absolute bottom-3 left-3 bg-blue-500 text-white">{category}</span>
    <span class="badge absolute bottom-3 right-3 bg-yellow-300 text-black">{theme}</span>
  </div>
  <div class="grid gap-4 p-5">
    <div>
      <h3 class="text-2xl font-black leading-tight">{title}</h3>
      <p class="mt-2 text-sm font-bold leading-6 text-slate-700">{summary}</p>
    </div>
    <div class="grid grid-cols-2 gap-2 text-xs font-black uppercase sm:grid-cols-4">
      <span>{players} spelers</span>
      <span>{age}</span>
      <span>{playtime}</span>
      <span>{complexity}/5</span>
    </div>
    <div class="flex items-center justify-between gap-4">
      <p class="text-sm font-black uppercase text-slate-700">Vanaf €{priceFrom}</p>
      <span class={`badge ${available ? 'bg-green-500 text-white' : 'bg-slate-300 text-black'}`}>{available ? 'Beschikbaar' : 'Verhuurd'}</span>
    </div>
    <a href={href} class={`btn w-full ${available ? 'green' : 'yellow'}`}>{available ? 'Bekijk spel' : 'Bekijk details'}</a>
  </div>
</article>
